#!/usr/bin/env bash
# Full Python gate — see docs/CODING_STANDARDS.md.
# Enable once per clone:  git config core.hooksPath scripts/hooks
set -u

# Resolve uv (not always on the hook's PATH).
UV="$(command -v uv || true)"
[ -z "$UV" ] && [ -x "$HOME/.local/bin/uv" ] && UV="$HOME/.local/bin/uv"
if [ -z "$UV" ]; then
    echo "pre-commit: uv not found (install: https://docs.astral.sh/uv/)" >&2
    exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root" || exit 1

fail=0
run() {
    echo "── $* ──"
    "$UV" run "$@" || fail=1
}

run ruff format --check .
run ruff check .
run pylint
run pyright
run pytest

if [ "$fail" -ne 0 ]; then
    echo >&2
    echo "pre-commit: gate failed — fix the above or commit with --no-verify to bypass." >&2
    exit 1
fi
