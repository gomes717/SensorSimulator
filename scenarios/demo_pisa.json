{
  "name": "PISA demo",
  "actions": [
    { "at_s": 0,  "kind": "speed",        "args": { "multiplier": 60 } },
    { "at_s": 1,  "kind": "run_state",    "args": { "state": "start" } },
    { "at_s": 12, "kind": "insert_food",  "args": { "carbs_g": 60, "duration_min": 15 } },
    { "at_s": 45, "kind": "inject_fault", "args": { "fault": "pisa", "duration_min": 12, "depth_frac": 0.4 } },
    { "at_s": 110, "kind": "run_state",   "args": { "state": "stop" } }
  ]
}
