        { "type": "hr",    "time_min": 200, "bpm": 140, "duration_min": 30 },

        { "type": "meal",  "time_min": 330, "carbs_g": 45, "duration_min": 15 },
        { "type": "bolus", "time_min": 330, "units": 4.5,  "duration_min": 5 },

        { "type": "meal",  "time_min": 600, "carbs_g": 70, "duration_min": 20 },
        { "type": "bolus", "time_min": 600, "units": 7.0,  "duration_min": 5 }
    ]
}
